{
  "seed": 17,
  "data": {
    "train_manifest": "data/manifests/bdd100k_train_labeled.jsonl",
    "val_manifest": "data/manifests/bdd100k_val_labeled.jsonl",
    "image_size": [384, 640],
    "num_workers": 4
  },
  "model": {
    "patch_size": 16, "dim": 384, "depth": 12, "heads": 6,
    "predictor_dim": 192, "predictor_depth": 4, "predictor_heads": 6,
    "mask_ratio": 0.6
  },
  "object_pretraining": {
    "objective": "jepa", "mask_mode": "objects", "max_objects": 4,
    "object_loss_weight": 1.0,
    "box_source": "human_annotated_legacy_BDD100K_oracle_boxes_not_YOLO_predictions",
    "annotation_status": "available_legacy_bdd100k"
  },
  "corruption": {
    "families": ["fog", "rain", "motion_blur", "low_light"],
    "train_severities": [1, 2, 3], "eval_severities": [1, 2, 3, 4, 5]
  },
  "training": {
    "epochs": 10, "batch_size": 8, "learning_rate": 0.00005,
    "weight_decay": 0.05, "warmup_fraction": 0.1, "ema_start": 0.996,
    "variance_weight": 0.05, "variance_floor": 0.1, "gradient_clip": 1.0,
    "validation_batches": 32, "amp_bfloat16": true, "save_every_steps": 128
  }
}
